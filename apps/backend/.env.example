# Application
ENVIRONMENT=development
DEBUG=true

# Hosting (replaces origin PowerServer localhost:5088 mindset)
PUBLIC_API_URL=http://localhost:8000
BIND_HOST=0.0.0.0
BIND_PORT=8000
HTTPS_ENABLED=false
SESSION_TIMEOUT_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=3600
TRANSACTION_TIMEOUT_SECONDS=120

# License gate (presence only; never commit secret values)
LICENSE_REQUIRED=false
# APPEON_LICENSE_KEY=
# LICENSE_KEY=

# Database (Postgres-only; SQL Anywhere is origin-only)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/power_builder

# CORS
CORS_ORIGINS=http://localhost:4200

# API
API_V1_PREFIX=/api/v1

# PSR fixtures (optional override)
# PSR_FIXTURES_ROOT=
